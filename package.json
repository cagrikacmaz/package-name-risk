{
  "name": "package-name-risk",
  "version": "1.0.0",
  "description": "A lightweight TypeScript library and CLI for detecting suspicious package-name similarity and common typosquatting patterns.",
  "keywords": [
    "package-security",
    "typosquatting",
    "dependency-security",
    "npm",
    "supply-chain",
    "homoglyph"
  ],
  "license": "MIT",
  "author": "Çağrı Kaçmaz",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "package-name-risk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cagrikacmaz/package-name-risk.git"
  },
  "bugs": {
    "url": "https://github.com/cagrikacmaz/package-name-risk/issues"
  },
  "homepage": "https://github.com/cagrikacmaz/package-name-risk#readme",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.26.0",
    "prettier": "^3.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.0"
  }
}
